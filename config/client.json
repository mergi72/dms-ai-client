{
  "assistant": {
    "name": "Demi",
    "voice": "Vlasta"
  },
  "voice": {
    "transcription": {
      "model": "gpt-transcribe",
      "languages": ["cs"],
      "prompt": "České hlasové příkazy pro práci s firemním DMS. Uživatel vyhledává zakázky, složky a dokumenty a často diktuje čísla zakázek.",
      "keywords": [
        "kdo jsi",
        "k čemu sloužíš",
        "otevři",
        "připoj se",
        "vyhledej",
        "zakázky v realizaci",
        "nabídky procesu",
        "nabídky neúspěšné",
        "zakázky ukončené",
        "dokumentace",
        "DMS",
        "Alfresco",
        "eDoCat",
        "WebDAV"
      ],
      "learning": {
        "enabled": true,
        "requireConfirmation": true,
        "maxKeywords": 200,
        "maxCorrections": 200
      }
    }
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-5.6-terra",
    "credentialId": "openai/eli",
    "maxOutputTokens": 6000,
    "reasoningEffort": "low"
  },
  "broker": {
    "url": "http://127.0.0.1:8776"
  },
  "mcp": {
    "command": "../dms-mcp-server/.venv/Scripts/dms-mcp-server.exe",
    "workingDirectory": "../dms-mcp-server",
    "timeoutSeconds": 30
  },
  "ui": {
    "host": "127.0.0.1",
    "port": 8790,
    "maxAttachmentBytes": 10485760,
    "maxArchiveExtractedBytes": 5242880,
    "maxArchiveFiles": 200
  }
}
